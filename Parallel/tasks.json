{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build & Run (OpenMP)",
            "type": "shell",
            "command": "clang++ -O3 -std=c++17 -Xpreprocessor -fopenmp -I$(brew --prefix libomp)/include -L$(brew --prefix libomp)/lib -lomp -o radix_sort radix_sort.cpp && ./radix_sort",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
